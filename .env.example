ADMIN_PASSWORD=change-this-to-a-long-random-password
# URL publik untuk canonical, sitemap, dan gambar pratinjau tautan:
NEXT_PUBLIC_SITE_URL=https://hapakat.vercel.app
# Untuk Postgres (wajib pada Vercel, opsional saat pengembangan lokal):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/hapakat?sslmode=require
# Hanya diperlukan ketika mengunggah ulang video ke ImageKit:
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_UPLOAD_FOLDER=/hapakat
